# Database — PostgreSQL required for production (Vercel)
# For local dev, you can use: postgresql://user:password@localhost:5432/billflow
# For Vercel/Neon, get your connection string from: https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL — set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email (optional) — get API key from: https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BillFlow <billing@yourdomain.com>"
